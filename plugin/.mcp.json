{
  "mcpServers": {
    "pw-read": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@0.0.83", "--isolated", "--headless", "--block-service-workers", "--no-webmcp"]
    },
    "pw-local": {
      "command": "cmd",
      "args": ["/c", "npx", "-y", "@playwright/mcp@0.0.83", "--isolated", "--headless", "--allowed-origins", "http://localhost:5173;http://127.0.0.1:5173;http://localhost:4173;http://127.0.0.1:4173;http://localhost:8080;http://127.0.0.1:8080"]
    }
  }
}
